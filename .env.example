# Ari Google authentication (the client ID is public; never add a client secret)
GOOGLE_CLIENT_ID=
ARI_ALLOWED_EMAILS=
ARI_REGISTRATION_MODE=restricted
# Set to "open" for automatic registration by any verified Google account; ARI_ALLOWED_EMAILS is then unnecessary.
ARI_SESSION_TTL_SECONDS=28800
ARI_PUBLIC_ORIGIN=

# Per-Google-account playground usage limits and private persistent data directory
ARI_DAILY_MESSAGE_LIMIT=100
ARI_MESSAGES_PER_MINUTE=10
ARI_DATA_DIR=./data

# Public web search is disabled until an administrator explicitly enables it.
SEARCH_ENABLED=false
SEARCH_PROVIDER_ORDER=searxng,serper,tavily
SEARCH_STRATEGY=adaptive
SEARCH_TIMEOUT_MS=12000
SEARCH_MAX_RESULTS=8
SEARCH_MAX_FALLBACKS=2
SEARCH_RESEARCH_MODE=false
SEARCH_MONTHLY_SOFT_LIMIT=900
SEARCH_MAX_CONCURRENT=4
SEARCH_CIRCUIT_FAILURES=3
SEARCH_CIRCUIT_COOLDOWN_MS=60000

# Keep provider credentials server-side. Leave blank until the account owner is authorized.
TAVILY_API_KEY=
SERPER_API_KEY=

# SearXNG requires the base URL of an instance we administer; no standard API key is needed.
SEARXNG_BASE_URL=

# Optional per-provider monthly request caps (0 means no provider-specific cap).
SEARXNG_MONTHLY_SOFT_LIMIT=0
SERPER_MONTHLY_SOFT_LIMIT=0
TAVILY_MONTHLY_SOFT_LIMIT=0
